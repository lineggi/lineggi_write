# 실제 값은 .env 에만 넣고, .env 는 절대 커밋하지 마세요 (.gitignore 처리됨)
TELEGRAM_TOKEN=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MY_CHAT_ID=
SHEET_NAME=Brunch_news
# 키워드는 매 실행마다 달라지므로 .env 가 아닌 실행 시점에 입력:
#   python main.py "솔라나,토스뱅크"  또는 생략하면 텔레그램에서 추천+질문
USE_PERPLEXITY=true
DEBUG_TELEGRAM_PING=true
# 키워드 추천 기본 분야
TREND_DOMAIN=크립토
# 글 끝에 붙일 강의 판매 링크
LECTURE_URL=https://megastudyacademy.co.kr/camp/lecture/805
